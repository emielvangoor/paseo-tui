# Shared look for the README's GIF and screenshots (sourced by the other tapes).
Set Shell "bash"
Set FontFamily "JetBrainsMono NFM, JetBrains Mono, Fira Code, Menlo"
Set FontSize 15
Set LineHeight 1.25
Set Width 1600
Set Height 940
Set Padding 18
Set Margin 0
Set WindowBar Colorful
Set WindowBarSize 36
Set BorderRadius 10
Set TypingSpeed 70ms
Set Theme { "name": "paseo", "black": "#1e1e2e", "red": "#f38ba8", "green": "#a6e3a1", "yellow": "#f9e2af", "blue": "#89b4fa", "magenta": "#cba6f7", "cyan": "#94e2d5", "white": "#cdd6f4", "brightBlack": "#585b70", "brightRed": "#f38ba8", "brightGreen": "#a6e3a1", "brightYellow": "#f9e2af", "brightBlue": "#89b4fa", "brightMagenta": "#cba6f7", "brightCyan": "#94e2d5", "brightWhite": "#ffffff", "background": "#11111b", "foreground": "#cdd6f4", "selection": "#45475a", "cursor": "#f5e0dc" }
# true color, so the app draws its own palette
Env TERM "xterm-256color"
Env COLORTERM "truecolor"
